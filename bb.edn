{:paths ["src" "resources" "test" "test/resources"]
 :deps {com.github.seancorfield/honeysql {:mvn/version "2.8.85"}
        metosin/malli {:mvn/version "0.20.3"}}
 :tasks {:init (defn suite
                "The test runner's arguments for bb test:jvm or test:floor <suite>: all, without a suite;
                 main, all but pgmalli-next.oracle-test; oracle, pgmalli-next.oracle-test (CI runs each in a job)."
                [all main]
                (case (first *command-line-args*) nil all "main" main "oracle" ["-n" "pgmalli-next.oracle-test"]))
         lint {:doc "clj-kondo over src, test and dev"
               :task (shell "clj-kondo --lint src test dev")}
         test:matrix {:doc "bb test against the PostgreSQL versions CI covers (needs docker)"
                      :extra-paths ["dev"]
                      :requires ([ci-images])
                      :task (doseq [[v image] (ci-images/images)]
                              (println "==" v)
                              (shell {:extra-env {"PGMALLI_PG_IMAGE" image}} "bb test"))}
         upstream {:doc "The JVM suite against the newest HoneySQL, next.jdbc, pgjdbc, malli and postgres:alpine, with what to update (needs docker)"
                   :task (load-file "dev/upstream.clj")}
         sweep {:doc "bb sweep <sql-dir> <out-dir> [glob]: run SQL files through the whole pipeline, findings as EDN (needs docker)"
                :extra-paths ["dev"]
                :task (load-file "dev/sweep.clj")}
         sweep:report {:doc "bb sweep:report <out-dir>: what a sweep found, grouped"
                       :extra-paths ["dev"]
                       :task (load-file "dev/sweep_report.clj")}
         mutate {:doc "bb mutate --file src/... [--kind table|logic] [--ns ns ...] [--fn def ...] [--limit N] [--jvm] [--db] [--timeout secs] [--out f.edn]: which mutants of a source file the tests miss: the bb suite, or the JVM suite under --jvm; database tests only under --db (needs docker)"
                 :extra-paths ["dev"]
                 :task (load-file "dev/mutate.clj")}
         docs:example {:doc "Rewrite docs/example/pgmalli-next.edn from docs/example/schema.sql (needs docker)"
                       :extra-paths ["dev"]
                       :task (load-file "dev/docs_example.clj")}
         catalog {:doc "Rewrite resources/pgmalli-next/impl/catalog.edn from pg_catalog of each PostgreSQL version CI runs (needs docker)"
                  :extra-paths ["dev"]
                  :requires ([catalog])
                  :task (catalog/-main)}
         catalog:dump {:doc "pg_catalog of the PGMALLI_PG_IMAGE server as JSON, which bb catalog reads"
                       :extra-paths ["dev"]
                       :requires ([catalog])
                       :task (prn (catalog/dump))}
         fixture {:doc "Rewrite test/resources/pgmalli-next/{sample,other,both}.edn, generated files of a schema each and of both, from dev/fixture.clj (no database)"
                  :extra-paths ["dev"]
                  :task (load-file "dev/fixture.clj")}
         test:nodb {:doc "bb test without the tests that need a database (no docker)"
                    :task (shell {:extra-env {"PGMALLI_SKIP_DB" "1"}} "bb test")}
         test {:doc "Run the test suite with babashka (every test/**/*_test.clj but the ones that need next.jdbc; needs docker)"
               :extra-paths ["dev"]
               :requires ([clojure.test :as t] [bb-suite])
               :task (let [nss (bb-suite/namespaces false)
                           _ (apply require nss)
                           {:keys [fail error]} (apply t/run-tests nss)]
                       (when (pos? (+ fail error)) (System/exit 1)))}
         oracle {:doc "bb oracle [seed] [mutants-per-query]: check against PostgreSQL on many queries, with the misses (JVM, needs docker)"
                 :task (apply shell "clojure -M:test:oracle" *command-line-args*)}
         test:docs {:doc "Run the code of README.md and docs/*.md and check every ;; => (JVM)"
                    :task (do (shell "clojure -X:test-doc-blocks")
                              (shell "clojure -M:test:docs -d target/test-doc-blocks/test"))}
         test:update {:doc "bb test:update [ns ...]: run the bb suite and write each failing (is (= literal form)) back with what it got; read the git diff (needs docker)"
                      :extra-paths ["dev"]
                      :requires ([update-expected])
                      :task (apply update-expected/-main *command-line-args*)}
         test:update:jvm {:doc "bb test:update:jvm [ns ...]: bb test:update on the JVM, for the namespaces that need next.jdbc too (needs docker)"
                          :task (apply shell "clojure -M:test:test-update" *command-line-args*)}
         test:stricter {:doc "Rewrite test/resources/pgmalli-next/stricter.edn, where PostgreSQL takes a parameter that accept/holds? leaves out (JVM, needs docker); read the diff"
                        :task (shell {:extra-env {"PGMALLI_UPDATE_STRICTER" "1"}} "clojure -M:test -n pgmalli-next.accept-test")}
         test:docs:update {:doc "bb test:docs:update [file.md ...]: rewrite each ;; => of the docs with what its form gives (JVM); read the git diff"
                           :task (apply shell "clojure -M:test:docs-update" *command-line-args*)}
         test:jvm {:doc "bb test:jvm [main|oracle]: run the test suite on the JVM, or one part of it (needs docker)"
                   :task (apply shell "clojure -M:test" (suite [] ["-r" "pgmalli-next\\.(?!oracle-test$).*-test$"]))}
         ;; the oldest versions README supports, in a string: as deps (in deps.edn or as EDN here)
         ;; Renovate would raise them
         test:floor {:doc "bb test:floor [main|oracle]: run the JVM suite, or one part of it, on the oldest Clojure, HoneySQL, malli, next.jdbc and pgjdbc README supports (needs docker)"
                     :task (apply shell "clojure" "-Sdeps"
                                  "{:aliases {:floor {:override-deps {com.github.seancorfield/honeysql {:mvn/version \"2.4.1066\"} org.clojure/clojure {:mvn/version \"1.11.4\"} metosin/malli {:mvn/version \"0.20.0\"} com.github.seancorfield/next.jdbc {:mvn/version \"1.3.1048\"} org.postgresql/postgresql {:mvn/version \"42.7.7\"}}}}}"
                                  "-M:test:floor" (suite [] ["-r" "pgmalli-next\\.(?!oracle-test$).*"]))}
         test:all {:doc "lint, bb test, test:jvm, test:floor, oracle and test:docs at once, each into target/<task>.log (: as -), and the exit code of each (needs docker)"
                   :requires ([babashka.fs :as fs] [babashka.process :as p] [clojure.string :as str])
                   :task (let [_ (fs/create-dirs "target")
                               runs (doall (for [t ["lint" "test" "test:jvm" "test:floor" "oracle" "test:docs"]
                                                 :let [log (str "target/" (str/replace t ":" "-") ".log")]]
                                             (future (let [start (System/nanoTime)
                                                           {:keys [exit]} (deref (p/process {:out (fs/file log) :err :out} "bb" t))]
                                                       {:task t :exit exit :secs (quot (- (System/nanoTime) start) 1000000000) :log log}))))
                               rs (mapv deref runs)]
                           (doseq [{:keys [task exit secs log]} rs]
                             (println (format "%-11s exit %d %4ds  %s" task exit secs log)))
                           (when (some (comp pos? :exit) rs) (System/exit 1)))}}}
