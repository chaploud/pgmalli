{:paths ["src" "resources" "test" "test/resources"]
 :deps {com.github.seancorfield/honeysql {:mvn/version "2.7.1437"}
        metosin/malli {:mvn/version "0.20.1"}}
 :tasks {lint {:doc "clj-kondo over src and test"
               :task (shell "clj-kondo --lint src test")}
         test:matrix {:doc "bb test against PostgreSQL 14 to 18, as CI does"
                      :task (doseq [v ["14" "15" "16" "17" "18"]]
                              (println "==" v)
                              (shell {:extra-env {"PGMALLI_PG_IMAGE" (str "postgres:" v "-alpine")}} "bb test"))}
         harvest {:doc "Rebuild test/corpus/harvested.edn (needs docker)"
                  :extra-paths ["dev"]
                  :task (load-file "dev/harvest.clj")}
         test {:doc "Run the test suite with babashka"
               :requires ([clojure.test :as t] [pgmalli.impl.ir-test] [pgmalli.impl.expr-test] [pgmalli.impl.pattern-test] [pgmalli.impl.compile-test] [pgmalli.impl.render-test] [pgmalli.core-test] [pgmalli.runtime-test] [pgmalli.fuzz-test] [pgmalli.corpus-test])
               :task (let [{:keys [fail error]} (t/run-tests 'pgmalli.impl.ir-test 'pgmalli.impl.expr-test 'pgmalli.impl.pattern-test 'pgmalli.impl.compile-test 'pgmalli.impl.render-test 'pgmalli.core-test 'pgmalli.runtime-test 'pgmalli.fuzz-test 'pgmalli.corpus-test)]
                       (when (pos? (+ fail error)) (System/exit 1)))}
         test:jvm {:doc "Run the test suite on the JVM"
                   :task (shell "clojure -M:test")}}}
