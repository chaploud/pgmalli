{:paths ["src" "resources" "test" "test/resources"]
 :deps {com.github.seancorfield/honeysql {:mvn/version "2.8.85"}
        metosin/malli {:mvn/version "0.20.3"}
        ;; next.jdbc's kebab builders name keys with it
        camel-snake-kebab/camel-snake-kebab {:mvn/version "0.4.3"}
        com.gfredericks/test.chuck {:mvn/version "0.2.15"}}
 :tasks {lint {:doc "clj-kondo over src, test and dev"
               :task (shell "clj-kondo --lint src test dev")}
         test:matrix {:doc "bb test against the PostgreSQL versions CI covers"
                      :requires ([clj-yaml.core :as yaml])
                      :task (doseq [v (get-in (yaml/parse-string (slurp ".github/workflows/ci.yml")) [:jobs :test :strategy :matrix :pg])]
                              (println "==" v)
                              (shell {:extra-env {"PGMALLI_PG_IMAGE" (str "postgres:" v "-alpine")}} "bb test"))}
         upstream {:doc "The JVM suite against the newest HoneySQL, next.jdbc, pgjdbc, malli and postgres:alpine, with what to update"
                   :task (load-file "dev/upstream.clj")}
         harvest {:doc "Rebuild test/corpus/harvested.edn (needs docker)"
                  :extra-paths ["dev"]
                  :task (load-file "dev/harvest.clj")}
         sweep {:doc "bb sweep <sql-dir> <out-dir> [glob]: run SQL files through the whole pipeline, findings as EDN (needs docker)"
                :extra-paths ["dev"]
                :task (load-file "dev/sweep.clj")}
         sweep:report {:doc "bb sweep:report <out-dir>: what a sweep found, grouped"
                       :extra-paths ["dev"]
                       :task (load-file "dev/sweep_report.clj")}
         mutate {:doc "bb mutate --file src/... [--kind table|logic] [--ns ns ...] [--fn def ...] [--limit N] [--jvm] [--db] [--timeout secs] [--out f.edn]: which mutants of a source file the tests miss: the bb suite, or the JVM suite under --jvm; database tests only under --db (needs docker)"
                 :extra-paths ["dev"]
                 :task (load-file "dev/mutate.clj")}
         docs:example {:doc "Rewrite docs/example/pgmalli/public.edn from docs/example/schema.sql (needs docker)"
                       :extra-paths ["dev"]
                       :task (load-file "dev/docs_example.clj")}
         catalog {:doc "Rewrite resources/pgmalli/impl/catalog.edn from pg_catalog of each PostgreSQL version CI runs (needs docker)"
                  :extra-paths ["dev"]
                  :requires ([catalog])
                  :task (catalog/-main)}
         catalog:dump {:doc "pg_catalog of the PGMALLI_PG_IMAGE server as JSON, which bb catalog reads"
                       :extra-paths ["dev"]
                       :requires ([catalog])
                       :task (prn (catalog/dump))}
         fixture {:doc "Rewrite test/resources/pgmalli/{sample,other}.edn from dev/fixture.clj (no database)"
                  :extra-paths ["dev"]
                  :task (load-file "dev/fixture.clj")}
         test {:doc "Run the test suite with babashka (every test/**/*_test.clj but the ones that need next.jdbc)"
               :extra-paths ["dev"]
               :requires ([clojure.test :as t] [bb-suite])
               :task (let [nss (bb-suite/namespaces false)
                           _ (apply require nss)
                           {:keys [fail error]} (apply t/run-tests nss)]
                       (when (pos? (+ fail error)) (System/exit 1)))}
         oracle {:doc "bb oracle [seed] [mutants-per-query]: check against PostgreSQL on many queries, with the misses (JVM, docker)"
                 :task (apply shell "clojure -M:test:oracle" *command-line-args*)}
         test:docs {:doc "Run the code of README.md and docs/*.md and check every ;; => (JVM)"
                    :task (do (shell "clojure -X:test-doc-blocks")
                              (shell "clojure -M:test:docs -d target/test-doc-blocks/test"))}
         test:update {:doc "bb test:update [ns ...]: run the bb suite and write each failing (is (= literal form)) back with what it got; read the git diff"
                      :extra-paths ["dev"]
                      :requires ([update-expected])
                      :task (apply update-expected/-main *command-line-args*)}
         test:update:jvm {:doc "bb test:update:jvm [ns ...]: bb test:update on the JVM, for the namespaces that need next.jdbc too"
                          :task (apply shell "clojure -M:test:test-update" *command-line-args*)}
         test:docs:update {:doc "bb test:docs:update [file.md ...]: rewrite each ;; => of the docs with what its form gives (JVM); read the git diff"
                           :task (apply shell "clojure -M:test:docs-update" *command-line-args*)}
         test:jvm {:doc "Run the test suite on the JVM"
                   :task (shell "clojure -M:test")}
         ;; the oldest versions README supports, in a string: as deps (in deps.edn or as EDN here)
         ;; Renovate would raise them. fuzz-test builds its CHECKs with HoneySQL, which 2.4.1066
         ;; writes IS DISTINCT FROM in wrong
         test:floor {:doc "Run the JVM suite on the oldest Clojure, HoneySQL, malli, next.jdbc and pgjdbc README supports"
                     :task (shell "clojure" "-Sdeps"
                                  "{:aliases {:floor {:override-deps {com.github.seancorfield/honeysql {:mvn/version \"2.4.1066\"} org.clojure/clojure {:mvn/version \"1.11.4\"} metosin/malli {:mvn/version \"0.20.0\"} com.github.seancorfield/next.jdbc {:mvn/version \"1.3.1048\"} org.postgresql/postgresql {:mvn/version \"42.7.7\"}}}}}"
                                  "-M:test:floor" "-r" "pgmalli\\.(?!fuzz-test).*")}}}
