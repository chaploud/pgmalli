{:paths ["src" "resources" "test" "test/resources"]
 :deps {com.github.seancorfield/honeysql {:mvn/version "2.7.1437"}
        metosin/malli {:mvn/version "0.20.1"}
        com.gfredericks/test.chuck {:mvn/version "0.2.15"}}
 :tasks {lint {:doc "clj-kondo over src and test"
               :task (shell "clj-kondo --lint src test dev")}
         test:matrix {:doc "bb test against the PostgreSQL versions CI covers"
                      :task (doseq [v ["16" "17" "18"]]
                              (println "==" v)
                              (shell {:extra-env {"PGMALLI_PG_IMAGE" (str "postgres:" v "-alpine")}} "bb test"))}
         harvest {:doc "Rebuild test/corpus/harvested.edn (needs docker)"
                  :extra-paths ["dev"]
                  :task (load-file "dev/harvest.clj")}
         sweep {:doc "bb sweep <sql-dir> <out-dir> [glob]: run SQL files through the whole pipeline, findings as EDN (needs docker)"
                :extra-paths ["dev"]
                :task (load-file "dev/sweep.clj")}
         sweep:report {:doc "bb sweep:report <out-dir>: what a sweep found, grouped"
                       :extra-paths ["dev"]
                       :task (load-file "dev/sweep_report.clj")}
         fixture {:doc "Rewrite test/resources/pgmalli/{sample,other}.edn from dev/fixture.clj (no database)"
                  :extra-paths ["dev"]
                  :task (load-file "dev/fixture.clj")}
         test {:doc "Run the test suite with babashka"
               :requires ([clojure.test :as t] [pgmalli.impl.ir-test] [pgmalli.impl.expr-test] [pgmalli.impl.pattern-test] [pgmalli.impl.eval-test] [pgmalli.honeysql-test] [pgmalli.impl.render-test] [pgmalli.impl.shape-test] [pgmalli.impl.files-test] [pgmalli.impl.portable-test] [pgmalli.generate-test] [pgmalli.core-test] [pgmalli.impl.registry-test] [pgmalli.impl.dataset-test] [pgmalli.impl.insert-test] [pgmalli.impl.jdbc-test] [pgmalli.data-test] [pgmalli.fuzz-test] [pgmalli.corpus-test])
               :task (let [{:keys [fail error]} (t/run-tests 'pgmalli.impl.ir-test 'pgmalli.impl.expr-test 'pgmalli.impl.pattern-test 'pgmalli.impl.eval-test 'pgmalli.honeysql-test 'pgmalli.impl.render-test 'pgmalli.impl.shape-test 'pgmalli.impl.files-test 'pgmalli.impl.portable-test 'pgmalli.generate-test 'pgmalli.core-test 'pgmalli.impl.registry-test 'pgmalli.impl.dataset-test 'pgmalli.impl.insert-test 'pgmalli.impl.jdbc-test 'pgmalli.data-test 'pgmalli.fuzz-test 'pgmalli.corpus-test)]
                       (when (pos? (+ fail error)) (System/exit 1)))}
         test:jvm {:doc "Run the test suite on the JVM"
                   :task (shell "clojure -M:test")}}}
