 [:insert-alias-returning {:insert-into [:posts :p] :values [{:user_id 1 :title "x"}] :returning [:p.id]}]
 [:insert-returning-bad {:insert-into :posts :values [{:user_id 1 :title "x"}] :returning [:nick]}]
