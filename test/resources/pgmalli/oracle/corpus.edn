 [:schema-qualified-col {:select [:public.users.id] :from [:public.users]}]
 [:schema-qualified-unknown {:select [:id] :from [:public.nosuch]}]
 [:system-columns {:select [:ctid :xmin :tableoid] :from [:users]}]
 [:whole-row {:select [:u] :from [[:users :u]]}]
 [:whole-row-table {:select [:users] :from [:users]}]
 [:whole-row-compare {:select [:u.id] :from [[:users :u]] :where [:is-distinct-from :u :u]}]
 [:fn-no-alias {:select [:generate_series] :from [[[:generate_series 1 3]]]}]
 [:values-no-col-alias {:select [:column1] :from [[{:values [[1 2]]} :v]]}]
 [:values-no-col-alias-q {:select [:v.column2] :from [[{:values [[1 2]]} :v]]}]
 [:outer-ref-in-nested-from {:select [:u.id] :from [[:users :u]] :where [:exists {:select [1] :from [[{:select [:*] :from [:posts] :where [:= :posts.user_id :u.id]} :s]]}]}]
 [:lateral-nested-from {:select [:b.id] :from [[:users :u] [[:lateral {:select [:*] :from [[{:select [:u.id]} :a]]}] :b]]}]
 [:lateral-chain {:select [:y.m] :from [[:users :u]] :join [[[:lateral {:select [[:u.score :n]]}] :x] true [[:lateral {:select [[:x.n :m]]}] :y] true]}]
 [:cte-vs-table-unqualified {:with [[:c {:select [[1 :x]]}]] :select [:title] :from [:c] :join [:posts true]}]
 [:sub-vs-table-unqualified {:select [:title] :from [[{:select [[:id :i]] :from [:users]} :s] :posts]}]
 [:cte-vs-table-ambiguous {:with [[:c {:select [:id] :from [:users]}]] :select [:id] :from [:c] :join [:posts true]}]
 [:group-ambiguous-input {:select [:u.name] :from [[:users :u] [:groups :g]] :group-by [:name]}]
 [:group-ordinal {:select [:group_id [:%count.* :n]] :from [:users] :group-by [1] :order-by [2]}]
 [:select-sub-sibling-alias {:select [[:nick :n] [{:select [:n]} :m]] :from [:users]}]
 [:on-exists {:select [:u.id] :from [[:users :u]] :join [[:posts :p] [:and [:= :p.user_id :u.id] [:exists {:select [1] :from [:post_tags] :where [:= :post_tags.post_id :p.id]}]]]}]
 [:update-where-exists {:update :users :set {:score 1} :where [:exists {:select [1] :from [:posts] :where [:= :posts.user_id :users.id]}]}]
 [:delete-alias-not-exists {:delete-from [:users :u] :where [:not [:exists {:select [1] :from [[:posts :p]] :where [:= :p.user_id :u.id]}]]}]
 [:update-from-sub-target-ref {:update :posts :set {:title "x"} :from [[{:select [:*] :from [:users] :where [:= :users.id :posts.user_id]} :s]]}]
 [:update-self-from {:update :users :set {:score :u2.score} :from [[:users :u2]] :where [:= :u2.id :users.id]}]
 [:update-target-unqualified-from {:update :posts :set {:title "x"} :from [:tags] :where [:= :title :name]}]
 [:delete-using-self {:delete-from :users :using [[:users :u2]] :where [:and [:= :u2.id :users.id] [:< :u2.score -100]]}]
 [:cte-in-update {:with [[:c {:select [:id] :from [:users]}]] :update :posts :set {:title "x"} :from [:c] :where [:= :c.id :posts.user_id]}]
 [:cte-in-delete {:with [[:c {:select [:id] :from [:users] :where [:< :score -100]}]] :delete-from :posts :using [:c] :where [:= :c.id :posts.user_id]}]
 [:cte-shadow-in-subquery {:select [:nick] :from [:users] :where [:exists {:with [[:users {:select [[1 :x]]}]] :select [:x] :from [:users] :where [:= :x 1]}]}]
 [:cte-shadow-outer-visible {:select [:nick] :from [:users] :where [:exists {:with [[:posts {:select [[1 :x]]}]] :select [:x] :from [:posts] :where [:= :x :users.score]}]}]
 [:cte-shadow-insert-target {:with [[:tags {:select [[1 :x]]}]] :insert-into :tags :values [{:name "x"}]}]
 [:cte-shadow-update-target {:with [[:posts {:select [[1 :x]]}]] :update :posts :set {:title "x"} :where [:= :id 0]}]
 [:union-nested {:union [{:select [[:nick :a]] :from [:users]} {:union [{:select [:title] :from [:posts]} {:select [:name] :from [:tags]}]}] :order-by [:a]}]
 [:union-order-desc {:union [{:select [:id :nick] :from [:users]} {:select [:id :title] :from [:posts]}] :order-by [[:nick :desc] [:id :asc]]}]
 [:union-order-ordinal {:union [{:select [:id :nick] :from [:users]} {:select [:id :title] :from [:posts]}] :order-by [2]}]
 [:distinct-on {:select-distinct-on [[:group_id] :group_id :nick] :from [:users] :order-by [:group_id :nick]}]
 [:order-desc-alias {:select [[:nick :n]] :from [:users] :order-by [[:n :desc]]}]
 [:returning-star {:insert-into :tags :values [{:name "w"}] :returning [:*]}]
 [:returning-alias-out {:insert-into :tags :values [{:name "w"}] :returning [[:id :new_id]]}]
 [:returning-excluded {:insert-into :tags :values [{:name "x"}] :on-conflict [:name] :do-update-set {:name :EXCLUDED.name} :returning [:EXCLUDED.id]}]
 [:returning-excluded-plain {:insert-into :tags :values [{:name "x"}] :returning [:EXCLUDED.id]}]
 [:upsert-where-target {:insert-into :tags :values [{:name "x"}] :on-conflict [:name] :do-update-set {:fields [:name] :where [:= :tags.id 1]}}]
 [:upsert-where-excluded-bad {:insert-into :tags :values [{:name "x"}] :on-conflict [:name] :do-update-set {:fields [:name] :where [:= :EXCLUDED.nick "a"]}}]
 [:upsert-where-unqualified {:insert-into :tags :values [{:name "x"}] :on-conflict [:name] :do-update-set {:fields [:name] :where [:= :id 1]}}]
 [:upsert-fields-bad {:insert-into :tags :values [{:name "x"}] :on-conflict [:name] :do-update-set {:fields [:nick]}}]
 [:insert-columns-select {:insert-into [[:tags [:name]] {:select [:title] :from [:posts]}] :on-conflict [] :do-nothing true}]
 [:insert-select-cte-inside {:insert-into [[:tags [:name]] {:with [[:c {:select [:title] :from [:posts]}]] :select [:title] :from [:c]}] :on-conflict [] :do-nothing true}]
 [:insert-values-correlated-cte {:with [[:c {:select [[1 :uid]]}]] :insert-into :posts :values [{:user_id {:select [:uid] :from [:c]} :title "x"}]}]
 [:exists-bad-select-col {:select [:id] :from [:users] :where [:exists {:select [:nosuch] :from [:posts]}]}]
 [:having-outer-sub {:select [:group_id] :from [:users] :group-by [:group_id] :having [:exists {:select [1] :from [:groups] :where [:= :groups.id :users.group_id]}]}]
 [:composite-in {:select [:u.id] :from [[:users :u]] :where [:in [:composite :u.id :u.group_id] {:select [:id :group_id] :from [:users]}]}]
 [:join-alias-reuse-outer {:select [:u.id] :from [[:users :u]] :where [:exists {:select [1] :from [[:posts :u]] :where [:= :u.title "x"]}]}]
 [:join-alias-reuse-outer-bad {:select [:u.id] :from [[:users :u]] :where [:exists {:select [1] :from [[:posts :u]] :where [:= :u.nick "x"]}]}]
 [:cross-join {:select [:u.id :t.name] :from [[:users :u]] :cross-join [[:tags :t]]}]
 [:cross-join-ambiguous {:select [:name] :from [:users] :cross-join [:tags]}]
 [:join-later-visible-in-where {:select [:users.id] :from [:users] :join [:posts [:= :posts.user_id :users.id]] :where [:= :groups.id 1] :left-join [:groups [:= :groups.id :users.group_id]]}]
 [:right-join {:select [:u.id :p.title] :from [[:users :u]] :right-join [[:posts :p] [:= :p.user_id :u.id]]}]
 [:enum-update-from {:update :users :set {:score 1} :from [:groups] :where [:and [:= :groups.id :users.group_id] [:= :mood "sad"]]}]
 [:enum-join-on {:select [:u.id] :from [[:users :u]] :join [[:active_users :a] [:and [:= :a.id :u.id] [:= :a.mood "angry"]]]}]
 [:enum-not-in {:select [:id] :from [:users] :where [:not-in :mood ["happy" "nah"]]}]
 [:enum-like {:select [:id] :from [:users] :where [:like [:cast :mood :text] "h%"]}]
]
