 [:using-plain {:select [:id] :from [:users] :join [:posts [:using :id]]}]
 [:using-qualified {:select [:users.id :posts.id] :from [:users] :join [:posts [:using :id]]}]
 [:using-left {:select [:id :title] :from [:users] :left-join [:posts [:using :id]]}]
 [:using-full {:select [:id] :from [:users] :full-join [:tags [:using :id]]}]
 [:using-three {:select [:id] :from [:users] :join [:tags [:using :id] :groups [:using :id]]}]
 [:using-where {:select [:nick] :from [:users] :join [:posts [:using :id]] :where [:= :id 1]}]
 [:using-other-ambiguous {:select [:created_at] :from [:posts] :join [:groups [:using :id]]}]
 [:using-two-cols {:select [:id :name] :from [:users] :join [:groups [:using :id :name]]}]
 [:using-bad-col {:select [:id] :from [:users] :join [:posts [:using :title]]}]
 [:alias-named-like-table {:select [:posts.nick] :from [[:users :posts]]}]
 [:alias-named-like-table-bad {:select [:posts.title] :from [[:users :posts]]}]
 [:upper-case-names {:select [:ID :Nick] :from [:USERS] :where [:= :Users.ID 1]}]
