 [:upsert-alias-hidden {:insert-into [:tags :t] :values [{:name "x"}] :on-conflict [:name] :do-update-set {:name [:|| :tags.name :EXCLUDED.name]}}]
 [:upsert-unqualified {:insert-into :tags :values [{:name "x"}] :on-conflict [:name] :do-update-set {:name [:|| :name "!"]}}]
