;; [id honeysql-query]: hand-written queries over schema.sql, which pgmalli.oracle mutates and runs on PostgreSQL beside check
[
 ;; basics, aliases, views
 [:basic {:select [:id :nick] :from [:users]}]
 [:join-alias {:select [:u.id :g.name] :from [[:users :u]] :join [[:groups :g] [:= :g.id :u.group_id]]}]
 [:cross-ambiguous {:select [:id] :from [:users :groups]}]
 [:cross-qualified {:select [:users.id :groups.name] :from [:users :groups]}]
 [:alias-hides-name {:select [:users.id] :from [[:users :u]]}]
 [:view-star {:select [:*] :from [:active_users]}]
 [:view-cols {:select [:nick :mood] :from [:active_users] :where [:= :mood "happy"]}]
 [:view-missing-col {:select [:score] :from [:active_users]}]
 [:unknown-table {:select [:id] :from [:nosuch]}]
 [:qualified-star {:select [:u.* :p.title] :from [[:users :u]] :join [[:posts :p] [:= :p.user_id :u.id]]}]
 [:star-unknown-alias {:select [:x.*] :from [[:users :u]]}]
 ;; enum literals
 [:enum-bad {:select [:id] :from [:users] :where [:= :mood "angry"]}]
 [:enum-in {:select [:id] :from [:users] :where [:in :mood ["happy" "angry"]]}]
 [:enum-view {:select [:id] :from [:active_users] :where [:= :mood "angry"]}]
 [:enum-ok {:select [:id] :from [:users] :where [:in :mood ["happy" "sad"]]}]
 [:enum-subquery-out {:select [:*] :from [[{:select [:mood] :from [:users]} :s]] :where [:= :s.mood "angry"]}]
 [:enum-cte-out {:with [[:c {:select [:mood] :from [:users]}]] :select [:*] :from [:c] :where [:= :mood "angry"]}]
 [:enum-insert {:insert-into :users :values [{:group_id 1 :score 1 :mood "angry"}]}]
 [:enum-update {:update :users :set {:mood "angry"} :where [:= :id 0]}]
 [:enum-reversed {:select [:id] :from [:users] :where [:= "angry" :mood]}]
 [:enum-cast-text {:select [:id] :from [:users] :where [:= [:cast :mood :text] "angry"]}]
 ;; subqueries in FROM / LATERAL
 [:from-sub {:select [:s.n] :from [[{:select [[:nick :n]] :from [:users]} :s]]}]
 [:from-sub-old-name {:select [:s.nick] :from [[{:select [[:nick :n]] :from [:users]} :s]]}]
 [:from-sub-unaliased-count {:select [:s.count] :from [[{:select [:%count.*] :from [:users]} :s]]}]
 [:from-sub-unaliased-fn {:select [:s.lower] :from [[{:select [[[:lower :nick]]] :from [:users]} :s]]}]
 [:from-sub-qualified-out {:select [:s.nick] :from [[{:select [:u.nick] :from [[:users :u]]} :s]]}]
 [:from-sub-star {:select [:s.score] :from [[{:select [:*] :from [:users]} :s]]}]
 [:from-sub-star-missing {:select [:s.title] :from [[{:select [:*] :from [:users]} :s]]}]
 [:from-sub-qstar {:select [:s.title :s.score] :from [[{:select [:u.* :p.title] :from [[:users :u]] :join [[:posts :p] [:= :p.user_id :u.id]]} :s]]}]
 [:from-sub-dup-out {:select [:s.id] :from [[{:select [:u.id :p.id] :from [[:users :u]] :join [[:posts :p] [:= :p.user_id :u.id]]} :s]]}]
 [:from-sub-col-alias {:select [:s.n] :from [[{:select [:nick] :from [:users]} [:s {:columns [:n]}]]]}]
 [:from-sub-col-alias-old {:select [:s.nick] :from [[{:select [:nick] :from [:users]} [:s {:columns [:n]}]]]}]
 [:from-sub-not-lateral {:select [:*] :from [[:users :u] [{:select [:id] :from [:posts] :where [:= :posts.user_id :u.id]} :p]]}]
 [:lateral {:select [:u.id :p.id] :from [[:users :u] [[:lateral {:select [:id] :from [:posts] :where [:= :posts.user_id :u.id]}] :p]]}]
 [:lateral-join {:select [:u.id :x.n] :from [[:users :u]] :join [[[:lateral {:select [[:u.score :n]]}] :x] true]}]
 [:lateral-unqualified-outer {:select [:x.n] :from [[:users :u]] :join [[[:lateral {:select [[:score :n]]}] :x] true]}]
 [:sub-cte-not-visible {:select [:*] :from [[{:with [[:c {:select [[1 :a]]}]] :select [:*] :from [:c]} :s] :c]}]
 [:fn-from {:select [:g] :from [[[:generate_series 1 3] :g]]}]
 [:fn-from-qualified {:select [:g.g] :from [[[:generate_series 1 3] :g]]}]
 [:fn-from-wrong-col {:select [:g.x] :from [[[:generate_series 1 3] :g]]}]
 [:fn-implicit-lateral {:select [:u.id :g] :from [[:users :u] [[:generate_series 1 :u.score] :g]]}]
 [:fn-col-alias {:select [:t.x] :from [[[:unnest [:array [1 2]]] [:t {:columns [:x]}]]]}]
 [:fn-col-alias-bad {:select [:t.y] :from [[[:unnest [:array [1 2]]] [:t {:columns [:x]}]]]}]
 [:values-alias {:select [:v.a :v.b] :from [[{:values [[1 2] [3 4]]} [:v {:columns [:a :b]}]]]}]
 [:values-alias-bad {:select [:v.c] :from [[{:values [[1 2] [3 4]]} [:v {:columns [:a :b]}]]]}]
 [:values-alias-unqualified {:select [:a] :from [[{:values [[1 2]]} [:v {:columns [:a :b]}]]]}]
 [:values-standalone {:values [[1 2] [3 4]]}]
 ;; correlated subqueries
 [:exists-correlated {:select [:id] :from [:users] :where [:exists {:select [1] :from [:posts] :where [:= :posts.user_id :users.id]}]}]
 [:exists-outer-unqualified {:select [:id] :from [:users] :where [:exists {:select [1] :from [:posts] :where [:= :user_id :score]}]}]
 [:in-sub-shadow {:select [:id] :from [:users] :where [:in :id {:select [:id] :from [:posts]}]}]
 [:in-sub-ambiguous {:select [:id] :from [:users] :where [:in :id {:select [:id] :from [:posts :tags]}]}]
 [:select-sub {:select [:u.id [{:select [[:%count.*]] :from [:posts] :where [:= :posts.user_id :u.id]} :n]] :from [[:users :u]]}]
 [:select-sub-shadow {:select [:id [{:select [:title] :from [:posts] :where [:= :user_id :id] :limit 1} :t]] :from [:users]}]
 [:select-sub-outer-col {:select [:id [{:select [:title] :from [:posts] :where [:= :nick :title] :limit 1} :t]] :from [:users]}]
 [:nested-2 {:select [:u.id] :from [[:users :u]] :where [:exists {:select [1] :from [:posts] :where [:and [:= :posts.user_id :u.id] [:exists {:select [1] :from [:post_tags] :where [:and [:= :post_tags.post_id :posts.id] [:> :u.score -1]]}]]}]}]
 [:exists-bad-outer-alias {:select [:id] :from [:users] :where [:exists {:select [1] :from [:posts] :where [:= :posts.user_id :zz.id]}]}]
 [:sibling-alias {:select [:*] :from [[:users :u]] :where [:and [:exists {:select [1] :from [[:posts :p]]}] [:exists {:select [1] :from [:tags] :where [:= :tags.id :p.id]}]]}]
 [:sub-alias-leak {:select [:p.id] :from [[:users :u]] :where [:exists {:select [1] :from [[:posts :p]]}]}]
 ;; CTEs
 [:cte {:with [[:c {:select [:id :nick] :from [:users]}]] :select [:c.nick] :from [:c]}]
 [:cte-missing-col {:with [[:c {:select [:id] :from [:users]}]] :select [:nick] :from [:c]}]
 [:cte-shadow-table {:with [[:users {:select [[1 :x]]}]] :select [:x] :from [:users]}]
 [:cte-shadow-table-realcol {:with [[:users {:select [[1 :x]]}]] :select [:nick] :from [:users]}]
 [:cte-shadow-enum {:with [[:users {:select [[[:cast "z" :text] :mood]]}]] :select [:*] :from [:users] :where [:= :mood "angry"]}]
 [:cte-earlier {:with [[:a {:select [:id] :from [:users]}] [:b {:select [:id] :from [:a]}]] :select [:id] :from [:b]}]
 [:cte-later {:with [[:a {:select [:id] :from [:b]}] [:b {:select [:id] :from [:users]}]] :select [:id] :from [:a]}]
 [:cte-in-subquery {:with [[:c {:select [:id] :from [:users]}]] :select [:*] :from [:posts] :where [:in :user_id {:select [:id] :from [:c]}]}]
 [:cte-nested-shadow {:with [[:c {:select [:id] :from [:users]}]] :select [:*] :from [:c] :where [:exists {:with [[:c {:select [:title] :from [:posts]}]] :select [:title] :from [:c]}]}]
 [:cte-col-rename {:with [[[:c {:columns [:x]}] {:select [:id] :from [:users]}]] :select [:x] :from [:c]}]
 [:cte-col-rename-old {:with [[[:c {:columns [:x]}] {:select [:id] :from [:users]}]] :select [:id] :from [:c]}]
 [:cte-values {:with [[[:v {:columns [:a]}] {:values [[1] [2]]}]] :select [:a] :from [:v]}]
 [:cte-values-bad {:with [[[:v {:columns [:a]}] {:values [[1] [2]]}]] :select [:b] :from [:v]}]
 [:cte-recursive {:with-recursive [[[:t {:columns [:n]}] {:union-all [{:select [1]} {:select [[[:+ :n 1]]] :from [:t] :where [:< :n 5]}]}]] :select [:n] :from [:t]}]
 [:cte-recursive-nocols {:with-recursive [[:t {:union-all [{:select [[1 :n]]} {:select [[[:+ :n 1]]] :from [:t] :where [:< :n 5]}]}]] :select [:n] :from [:t]}]
 [:cte-recursive-badcol {:with-recursive [[:t {:union-all [{:select [[1 :n]]} {:select [[[:+ :m 1]]] :from [:t] :where [:< :n 5]}]}]] :select [:n] :from [:t]}]
 [:cte-self-not-recursive {:with [[:t {:union-all [{:select [[1 :n]]} {:select [[[:+ :n 1]]] :from [:t] :where [:< :n 5]}]}]] :select [:n] :from [:t]}]
 [:cte-dml {:with [[:ins {:insert-into :tags :values [{:name "q"}] :returning [:id]}]] :select [:id] :from [:ins]}]
 [:cte-dml-badcol {:with [[:ins {:insert-into :tags :values [{:name "q"}] :returning [:id]}]] :select [:name] :from [:ins]}]
 [:cte-union {:with [[:c {:union [{:select [:nick] :from [:users]} {:select [:name] :from [:tags]}]}]] :select [:nick] :from [:c]}]
 [:cte-union-second-name {:with [[:c {:union [{:select [:nick] :from [:users]} {:select [:name] :from [:tags]}]}]] :select [:name] :from [:c]}]
 ;; set operations
 [:union-order {:union [{:select [:id :nick] :from [:users]} {:select [:id :title] :from [:posts]}] :order-by [:nick]}]
 [:union-order-second {:union [{:select [:id :nick] :from [:users]} {:select [:id :title] :from [:posts]}] :order-by [:title]}]
 [:union-order-qualified {:union [{:select [:id :nick] :from [:users]} {:select [:id :title] :from [:posts]}] :order-by [:users.nick]}]
 [:union-sub {:select [:s.id] :from [[{:union [{:select [:id] :from [:users]} {:select [:id] :from [:tags]}]} :s]]}]
 [:union-sub-second-name {:select [:s.name] :from [[{:union [{:select [:nick] :from [:users]} {:select [:name] :from [:tags]}]} :s]]}]
 [:intersect {:intersect [{:select [:name] :from [:users]} {:select [:name] :from [:tags]}] :order-by [:name]}]
 [:except {:except [{:select [:id] :from [:users]} {:select [:user_id] :from [:posts]}] :order-by [:id]}]
 [:union-all-limit {:union-all [{:select [[:nick :x]] :from [:users]} {:select [:title] :from [:posts]}] :order-by [:x] :limit 3}]
 ;; ORDER BY / GROUP BY / HAVING output names
 [:order-alias {:select [[:nick :n]] :from [:users] :order-by [:n]}]
 [:order-alias-expr {:select [[:nick :n]] :from [:users] :order-by [[[:lower :n]]]}]
 [:order-output-over-ambiguous {:select [:u.name] :from [[:users :u] [:groups :g]] :order-by [:name]}]
 [:order-expr-ambiguous {:select [:u.name] :from [[:users :u] [:groups :g]] :order-by [[[:lower :name]]]}]
 [:order-input-col {:select [:nick] :from [:users] :order-by [:score]}]
 [:group-alias {:select [[:nick :n] [:%count.* :c]] :from [:users] :group-by [:n]}]
 [:group-input-wins {:select [[:nick :name]] :from [:users] :group-by [:name]}]
 [:where-alias {:select [[:nick :n]] :from [:users] :where [:= :n "a"]}]
 [:having-alias {:select [:group_id [:%count.* :c]] :from [:users] :group-by [:group_id] :having [:> :c 1]}]
 [:having-ok {:select [:group_id [:%count.* :c]] :from [:users] :group-by [:group_id] :having [:> :%count.* 1]}]
 [:order-unknown {:select [:nick] :from [:users] :order-by [:zz]}]
 ;; joins
 [:left-join {:select [:u.nick :p.title] :from [[:users :u]] :left-join [[:posts :p] [:= :p.user_id :u.id]]}]
 [:full-join {:select [:u.nick :p.title] :from [[:users :u]] :full-join [[:posts :p] [:= :p.user_id :u.id]]}]
 [:join-using {:select [:id :users.nick] :from [:users] :join [:active_users [:using :id]]}]
 [:join-using-ambiguous {:select [:nick] :from [:users] :join [:active_users [:using :id]]}]
 [:join-ambiguous {:select [:name] :from [:users] :join [:groups [:= :groups.id :users.group_id]]}]
 [:join-ambiguous-created {:select [:created_at] :from [:posts] :join [:users [:= :users.id :posts.user_id] :groups [:= :groups.id :users.group_id]]}]
 [:join-on-later {:select [:users.id] :from [:users] :join [:posts [:= :posts.user_id :groups.id] :groups [:= :groups.id :users.group_id]]}]
 [:comma-then-join {:select [:users.id] :from [:users :groups] :join [:posts [:= :posts.user_id :users.id]]}]
 [:self-join {:select [:a.id :b.id] :from [[:users :a]] :join [[:users :b] [:= :a.group_id :b.group_id]]}]
 [:self-join-ambiguous {:select [:a.id :nick] :from [[:users :a]] :join [[:users :b] [:= :a.group_id :b.group_id]]}]
 [:same-table-twice {:select [:id] :from [:users :users]}]
 [:join-sub {:select [:u.id :c.n] :from [[:users :u]] :join [[{:select [:user_id [:%count.* :n]] :from [:posts] :group-by [:user_id]} :c] [:= :c.user_id :u.id]]}]
 [:join-sub-badcol {:select [:u.id :c.n] :from [[:users :u]] :join [[{:select [:user_id [:%count.* :n]] :from [:posts] :group-by [:user_id]} :c] [:= :c.id :u.id]]}]
 ;; INSERT
 [:insert-values {:insert-into :posts :values [{:user_id 1 :title "x"}]}]
 [:insert-missing {:insert-into :posts :values [{:user_id 1}]}]
 [:insert-null {:insert-into :posts :values [{:user_id 1 :title nil}]}]
