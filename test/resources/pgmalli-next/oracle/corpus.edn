 [:app-post-tags-agg {:select [:p.id :p.title [[:array_agg [:order-by :t.name :t.name]] :tag_names] [[:string_agg :t.name ", "] :tag_list]], :from [[:posts :p]], :left-join [[:post_tags :pt] [:= :pt.post_id :p.id] [:tags :t] [:= :t.id :pt.tag_id]], :group-by [:p.id :p.title]}]
