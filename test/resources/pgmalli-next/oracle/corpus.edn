 [:app-feed-keyset {:select [:p.id :p.title :p.created_at [:u.nick :author] [:g.name :group_name]], :from [[:posts :p]], :join [[:users :u] [:= :u.id :p.user_id] [:groups :g] [:= :g.id :u.group_id]], :where [:and [:< [:composite :p.created_at :p.id] [:composite :?before_at :?before_id]]], :order-by [[:p.created_at :desc] [:p.id :desc]], :limit :?limit}]
 [:app-page-total {:select [:p.id :p.title [[:over [[:count :*] {} :total]]]], :from [[:posts :p]], :where [:ilike :p.title [:|| "%" :?q "%"]], :order-by [[:p.id :desc]], :limit 20, :offset :?offset}]
 [:app-user-search {:select [:id [[:coalesce :nick :name "anonymous"] :display] :score], :from [:users], :where [:or [:ilike :nick :?pattern] [:ilike :name :?pattern]], :order-by [[:score :desc] :id], :limit 50}]
 [:app-report-daily {:select [[:g.name :group_name] [[:date_trunc "day" :p.created_at] :day] [:%count.* :posts]], :from [[:posts :p]], :join [[:users :u] [:= :u.id :p.user_id] [:groups :g] [:= :g.id :u.group_id]], :where [:>= :p.created_at [:- [:now] [:interval "30 days"]]], :group-by [:g.name [:date_trunc "day" :p.created_at]], :order-by [[:day :desc] :group_name]}]
 [:app-report-inactive {:select [:u.id :u.nick [[:count :p.id] :post_count] [[:max :p.created_at] :last_post_at]], :from [[:users :u]], :left-join [[:posts :p] [:= :p.user_id :u.id]], :group-by [:u.id :u.nick], :having [:< [:count :p.id] 1]}]
 [:app-report-filter {:select [:group_id [[:filter [:count :*] {:where [:> :score 0]}] :active] [[:filter [:avg :score] {:where [:= :mood [:cast "happy" :mood]]}] :happy_avg]], :from [:users], :group-by [:group_id]}]
 [:app-rank-per-group {:select [:*], :from [[{:select [:id :group_id :nick :score [[:over [[:row_number] {:partition-by [:group_id], :order-by [[:score :desc] :id]} :rn]]]], :from [:users]} :ranked]], :where [:= :rn 1]}]
