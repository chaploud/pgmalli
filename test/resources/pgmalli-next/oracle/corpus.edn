 [:app-lateral-topn {:select [:u.id :u.nick :lp.title :lp.created_at], :from [[:users :u]], :left-join [[[:lateral {:select [:title :created_at], :from [:posts], :where [:= :posts.user_id :u.id], :order-by [[:created_at :desc]], :limit 3}] :lp] true]}]
