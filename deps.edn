{:paths ["src" "resources"]
 :deps {org.clojure/data.json {:mvn/version "2.5.2"}
        metosin/malli {:mvn/version "0.20.3"}
        ;; next.jdbc's kebab builders name keys with it
        camel-snake-kebab/camel-snake-kebab {:mvn/version "0.4.3"}
        org.clojure/test.check {:mvn/version "1.1.3"}}
 :aliases
 {:test {:extra-paths ["test" "test/resources"]
         :extra-deps {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                      babashka/process {:mvn/version "0.6.25"}
                      org.postgresql/postgresql {:mvn/version "42.7.7"}
                      com.github.seancorfield/next.jdbc {:mvn/version "1.3.1048"}
                      com.github.seancorfield/honeysql {:mvn/version "2.8.85"}
                      ;; strings from regexes, which pgmalli uses when it is on the classpath
                      com.gfredericks/test.chuck {:mvn/version "0.2.15"}}
         :main-opts ["-m" "cognitect.test-runner"]}
  :build {:deps {io.github.clojure/tools.build {:git/tag "v0.10.14" :git/sha "1176afd"}}
          :ns-default build}
  :deploy {:extra-deps {slipset/deps-deploy {:mvn/version "0.2.5"}}
           :exec-fn deps-deploy.deps-deploy/deploy
           :exec-args {:installer :remote :artifact "target/pgmalli.jar"
                       :pom-file "target/classes/META-INF/maven/io.github.chaploud/pgmalli/pom.xml"}}}}
