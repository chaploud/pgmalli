{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommitsDisabled",
    "helpers:pinGitHubActionDigests"
  ],
  "schedule": [
    "before 9am on monday"
  ],
  "labels": [
    "dependencies"
  ],
  "packageRules": [
    {
      "description": "A release that was hijacked is usually pulled within days: wait before proposing it. A rule, not a top-level minimumReleaseAge, which would also hold pin and digest updates that carry no release date",
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ],
      "minimumReleaseAge": "5 days"
    },
    {
      "description": "Test, docs and build dependencies in one PR",
      "matchFileNames": [
        "deps.edn",
        "bb.edn"
      ],
      "groupName": "dev deps"
    },
    {
      "description": "What a user's project pulls in, in a PR of its own (overrides the rule above)",
      "matchFileNames": [
        "deps.edn"
      ],
      "matchDepNames": [
        "org.clojure/data.json",
        "metosin/malli",
        "org.clojure/test.check"
      ],
      "groupName": "runtime deps"
    },
    {
      "description": "GitHub Actions in one PR",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions"
    },
    {
      "description": "A PostgreSQL version of the CI matrix is added by hand (CONTRIBUTING.md): a new digest of each, in one PR, and no new major",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepNames": [
        "postgres"
      ],
      "groupName": "postgres images",
      "major": {
        "enabled": false
      }
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "The PostgreSQL images CI tests against, pinned by digest",
      "managerFilePatterns": [
        "/^\\.github/workflows/ci\\.yml$/"
      ],
      "matchStrings": [
        "(?<depName>postgres):(?<currentValue>\\d+-alpine)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
